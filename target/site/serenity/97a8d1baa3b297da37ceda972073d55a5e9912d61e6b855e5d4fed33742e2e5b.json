gba(255,255,255,0.8); font-size: 0.9rem; }\n        .nav a.nav-link:hover { color: white; text-decoration: none; }\n        .nav .spacer { flex: 1; }\n        .nav .btn-nav { background: #4caf50; color: white !important; padding: 7px 18px; border-radius: 20px; font-weight: 600; font-size: 0.88rem; }\n        .nav .btn-nav:hover { background: #388e3c; text-decoration: none; }\n\n        .container { max-width: 760px; margin: 0 auto; padding: 36px 24px; }\n\n        /* Campaign header card */\n        .campaign-header { background: white; border-radius: 12px; box-shadow: 0 2px 8px rgba(0,0,0,0.08); overflow: hidden; margin-bottom: 20px; }\n        .header-banner { background: linear-gradient(135deg, #1b5e20, #388e3c); padding: 28px 28px 20px; color: white; }\n        .header-banner h1 { font-size: 1.6rem; font-weight: 800; line-height: 1.25; margin-bottom: 10px; }\n        .header-banner .meta { font-size: 0.85rem; color: rgba(255,255,255,0.75); display: flex; gap: 16px; flex-wrap: wrap; }\n\n        /* Status badge */\n        .badge { display: inline-block; padding: 3px 12px; border-radius: 12px; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; }\n        .badge-WAITING { background: #fff8e1; color: #f57f17; }\n        .badge-OPEN { background: #e8f5e9; color: #2e7d32; }\n        .badge-CLOSED { background: #e3f2fd; color: #1565c0; }\n        .badge-CANCELLED { background: #fce4ec; color: #c62828; }\n        .badge-REJECTED { background: #ede7f6; color: #4527a0; }\n        .badge-FRAUD { background: #ffebee; color: #b71c1c; }\n        .badge-DELETED { background: #f5f5f5; color: #616161; }\n\n        /* Progress section */\n        .progress-section { padding: 20px 28px; border-bottom: 1px solid #f0f0f0; }\n        .progress-numbers { display: flex; justify-content: space-between; margin-bottom: 10px; flex-wrap: wrap; gap: 8px; }\n        .progress-raised { font-size: 1.5rem; font-weight: 800; color: #2e7d32; }\n        .progress-target { font-size: 0.9rem; color: #888; align-self: flex-end; padding-bottom: 4px; }\n        .progress-wrap { background: #e8f5e9; border-radius: 20px; height: 12px; overflow: hidden; }\n        .progress-fill { background: linear-gradient(90deg, #2e7d32, #66bb6a); height: 100%; border-radius: 20px; width: 0%; transition: width 0.8s ease; }\n        .progress-pct { text-align: right; font-size: 0.82rem; color: #666; margin-top: 6px; }\n\n        /* Stats row */\n        .stats-row { display: flex; padding: 16px 28px; gap: 0; border-bottom: 1px solid #f0f0f0; }\n        .stat { flex: 1; text-align: center; padding: 8px 12px; }\n        .stat + .stat { border-left: 1px solid #eee; }\n        .stat .s-value { font-size: 1.1rem; font-weight: 700; color: #1b5e20; }\n        .stat .s-label { font-size: 0.75rem; color: #888; text-transform: uppercase; letter-spacing: 0.4px; margin-top: 2px; }\n\n        /* Description */\n        .description-section { padding: 22px 28px; }\n        .description-section h3 { font-size: 0.85rem; color: #888; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 10px; }\n        .description-section p { color: #333; line-height: 1.7; white-space: pre-wrap; }\n\n        /* Action buttons */\n        .actions-card { background: white; border-radius: 12px; box-shadow: 0 2px 8px rgba(0,0,0,0.08); padding: 20px 24px; margin-bottom: 20px; }\n        .actions-card h3 { font-size: 0.85rem; color: #888; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 14px; }\n        .action-row { display: flex; gap: 10px; flex-wrap: wrap; }\n\n        .btn { display: inline-block; padding: 9px 20px; border-radius: 7px; font-size: 0.88rem; font-weight: 600; cursor: pointer; border: none; text-align: center; transition: background 0.15s; }\n        .btn-primary { background: #2e7d32; color: white; }\n        .btn-primary:hover { background: #1b5e20; color: white; text-decoration: none; }\n        .btn-outline { background: transparent; color: #2e7d32; border: 2px solid #c8e6c9; }\n        .btn-outline:hover { background: #e8f5e9; text-decoration: none; color: #2e7d32; }\n        .btn-danger { background: #c62828; color: white; }\n        .btn-danger:hover { background: #b71c1c; }\n        .btn-warn { background: #e65100; color: white; }\n        .btn-warn:hover { background: #bf360c; }\n        .btn-info { background: #1565c0; color: white; }\n        .btn-info:hover { background: #0d47a1; }\n\n        /* Alert */\n        .alert { padding: 12px 16px; border-radius: 8px; margin-bottom: 16px; font-size: 0.9rem; }\n        .alert-error { background: #ffebee; color: #c62828; border-left: 4px solid #c62828; }\n        .alert-success { background: #e8f5e9; color: #2e7d32; border-left: 4px solid #4caf50; }\n\n        /* Admin panel */\n        .admin-panel { background: white; border-radius: 12px; box-shadow: 0 2px 8px rgba(0,0,0,0.08); border: 2px solid #ff8f00; overflow: hidden; margin-bottom: 20px; }\n        .admin-panel-header { background: #fff8e1; padding: 14px 24px; display: flex; align-items: center; gap: 10px; border-bottom: 1px solid #ffe082; }\n        .admin-panel-header h3 { font-size: 1rem; font-weight: 700; color: #e65100; }\n        .admin-panel-body { padding: 20px 24px; display: flex; flex-direction: column; gap: 20px; }\n\n        .admin-section { }\n        .admin-section-title { font-size: 0.82rem; font-weight: 700; color: #888; text-transform: uppercase; letter-spacing: 0.4px; margin-bottom: 10px; }\n        .admin-section .btn-row { display: flex; gap: 10px; flex-wrap: wrap; }\n\n        /* Admin edit form */\n        .admin-edit-form { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }\n        .admin-edit-form .full { grid-column: 1 / -1; }\n        .form-group label { display: block; font-size: 0.82rem; font-weight: 600; color: #444; margin-bottom: 5px; }\n        .form-group input { width: 100%; padding: 8px 12px; border: 1px solid #ccc; border-radius: 6px; font-size: 0.9rem; }\n        .form-group input:focus { outline: none; border-color: #4caf50; box-shadow: 0 0 0 3px rgba(76,175,80,0.15); }\n\n        /* Breadcrumb */\n        .breadcrumb { font-size: 0.85rem; color: #888; margin-bottom: 20px; }\n        .breadcrumb a { color: #2e7d32; }\n        .breadcrumb span { color: #555; }\n\n        .footer { text-align: center; padding: 24px; color: #888; font-size: 0.82rem; border-top: 1px solid #dce8dc; margin-top: 32px; }\n\n        hr { border: none; border-top: 1px solid #e8f5e9; margin: 4px 0; }\n    \u003c/style\u003e\n  \u003c/head\u003e\n  \u003cbody\u003e\n    \u003cnav class\u003d\"nav\"\u003e\n      \u003ca shape\u003d\"rect\" class\u003d\"brand\" href\u003d\"/\"\u003eDonatJS\u003c/a\u003e\n      \u003cdiv class\u003d\"spacer\"/\u003e\n      \u003ca shape\u003d\"rect\" class\u003d\"nav-link\" href\u003d\"/campaigns\"\u003eCampaigns\u003c/a\u003e\n      \u003ca shape\u003d\"rect\" class\u003d\"btn-nav\" href\u003d\"/campaigns/create\"\u003e+ New Campaign\u003c/a\u003e\n    \u003c/nav\u003e\n    \u003cdiv class\u003d\"container\"\u003e\n      \u003cdiv class\u003d\"breadcrumb\"\u003e\n        \u003ca shape\u003d\"rect\" href\u003d\"/campaigns\"\u003e← All Campaigns\u003c/a\u003e\n        \u003cspan\u003e / \u003c/span\u003e\n        \u003cspan\u003eDetail Functional Test\u003c/span\u003e\n      \u003c/div\u003e\n      \u003cdiv class\u003d\"campaign-header\"\u003e\n        \u003cdiv class\u003d\"header-banner\"\u003e\n          \u003cdiv style\u003d\"display:flex; align-items:flex-start; justify-content:space-between; gap:12px; margin-bottom:10px;\"\u003e\n            \u003ch1\u003eDetail Functional Test\u003c/h1\u003e\n            \u003cspan class\u003d\"badge badge-OPEN\" style\u003d\"white-space:nowrap; margin-top:4px;\"\u003eOPEN\u003c/span\u003e\n          \u003c/div\u003e\n          \u003cdiv class\u003d\"meta\"/\u003e\n        \u003c/div\u003e\n        \u003cdiv class\u003d\"progress-section\"\u003e\n          \u003cdiv class\u003d\"progress-numbers\"\u003e\n            \u003cspan class\u003d\"progress-raised\"\u003eRp 0\u003c/span\u003e\n            \u003cspan class\u003d\"progress-target\"\u003eof Rp 500 goal\u003c/span\u003e\n          \u003c/div\u003e\n          \u003cdiv class\u003d\"progress-wrap\"\u003e\n            \u003cdiv class\u003d\"progress-fill\" id\u003d\"main-progress\" data-raised\u003d\"0\" data-target\u003d\"500\"/\u003e\n          \u003c/div\u003e\n          \u003cdiv class\u003d\"progress-pct\" id\u003d\"progress-pct-label\"/\u003e\n        \u003c/div\u003e\n        \u003cdiv class\u003d\"stats-row\"\u003e\n          \u003cdiv class\u003d\"stat\"\u003e\n            \u003cdiv class\u003d\"s-value\"\u003e2026-06-20\u003c/div\u003e\n            \u003cdiv class\u003d\"s-label\"\u003eDeadline\u003c/div\u003e\n          \u003c/div\u003e\n          \u003cdiv class\u003d\"stat\"\u003e\n            \u003cdiv class\u003d\"s-value\"\u003eRp 500\u003c/div\u003e\n            \u003cdiv class\u003d\"s-label\"\u003eTarget\u003c/div\u003e\n          \u003c/div\u003e\n          \u003cdiv class\u003d\"stat\"\u003e\n            \u003cdiv class\u003d\"s-value\"\u003eRp 0\u003c/div\u003e\n            \u003cdiv class\u003d\"s-label\"\u003eRaised\u003c/div\u003e\n          \u003c/div\u003e\n        \u003c/div\u003e\n        \u003cdiv class\u003d\"description-section\"\u003e\n          \u003ch3\u003eAbout this Campaign\u003c/h3\u003e\n          \u003cp\u003eFunctional test: Detail Functional Test\u003c/p\u003e\n        \u003c/div\u003e\n      \u003c/div\u003e\n      \u003cdiv class\u003d\"actions-card\"\u003e\n        \u003ch3\u003eActions\u003c/h3\u003e\n        \u003cdiv class\u003d\"action-row\"\u003e\n          \u003ca shape\u003d\"rect\" class\u003d\"btn btn-outline\" href\u003d\"/campaigns/1/edit\"\u003e\n                ✏️ Edit Description\n            \u003c/a\u003e\n          \u003cform enctype\u003d\"application/x-www-form-urlencoded\" method\u003d\"post\" action\u003d\"/campaigns/1/delete\" style\u003d\"display:inline;\"\u003e\n            \u003cbutton type\u003d\"submit\" class\u003d\"btn btn-danger\" onclick\u003d\"return confirm(\u0027Delete this campaign? This only works if no donations have been made.\u0027)\"\u003e\n                    🗑 Delete\n                \u003c/button\u003e\n          \u003c/form\u003e\n          \u003ca shape\u003d\"rect\" class\u003d\"btn btn-outline\" href\u003d\"/campaigns\"\u003e← Back to List\u003c/a\u003e\n        \u003c/div\u003e\n      \u003c/div\u003e\n    \u003c/div\u003e\n    \u003cdiv class\u003d\"footer\"\u003e\n    © 2025 DonatJS — Advanced Programming Course Project\n\u003c/div\u003e\n    \u003cscript\u003e\n    // Progress bar\n    (function () {\n        const bar \u003d document.getElementById(\u0027main-progress\u0027);\n        const label \u003d document.getElementById(\u0027progress-pct-label\u0027);\n        if (!bar) return;\n        const raised \u003d parseFloat(bar.dataset.raised) || 0;\n        const target \u003d parseFloat(bar.dataset.target) || 0;\n        if (target \u0026gt; 0) {\n            const pct \u003d Math.min(100, (raised / target) * 100);\n            setTimeout(() \u003d\u0026gt; bar.style.width \u003d pct.toFixed(1) + \u0027%\u0027, 100);\n            label.textContent \u003d pct.toFixed(1) + \u0027% of goal reached\u0027;\n        } else {\n            label.textContent \u003d \u0027No target set\u0027;\n        }\n    })();\n\n    // Admin actions\n    function approveCampaign(id) {\n        if (!confirm(\u0027Approve this campaign?\\nIt will become publicly visible.\u0027)) return;\n        fetch(\u0027/campaigns/\u0027 + id + \u0027/moderate\u0027, {\n            method: \u0027POST\u0027,\n            headers: { \u0027X-Admin\u0027: \u0027true\u0027, \u0027Content-Type\u0027: \u0027application/json\u0027 },\n            body: JSON.stringify({ approve: true })\n        }).then(r \u003d\u0026gt; r.ok ? location.reload() : r.text().then(t \u003d\u0026gt; alert(\u0027Error: \u0027 + t)));\n    }\n\n    function rejectCampaign(id) {\n        if (!confirm(\u0027Reject this campaign?\u0027)) return;\n        fetch(\u0027/campaigns/\u0027 + id + \u0027/moderate\u0027, {\n            method: \u0027POST\u0027,\n            headers: { \u0027X-Admin\u0027: \u0027true\u0027, \u0027Content-Type\u0027: \u0027application/json\u0027 },\n            body: JSON.stringify({ approve: false })\n        }).then(r \u003d\u0026gt; r.ok ? location.reload() : r.text().then(t \u003d\u0026gt; alert(\u0027Error: \u0027 + t)));\n    }\n\n    function markFraud(id) {\n        if (!confirm(\u0027⚠️ Mark as FRAUD?\\n\\nThis will:\\n• Set status to FRAUD\\n• Trigger refunds for all donations\\n• Publish fraud notification events\\n\\nThis cannot be undone.\u0027)) return;\n        fetch(\u0027/campaigns/\u0027 + id + \u0027/fraud\u0027, {\n            method: \u0027POST\u0027,\n            headers: { \u0027X-Admin\u0027: \u0027true\u0027 }\n        }).then(r \u003d\u0026gt; r.ok ? location.reload() : r.text().then(t \u003d\u0026gt; alert(\u0027Error: \u0027 + t)));\n    }\n\n    function runDeadlineAutomation() {\n        if (!confirm(\u0027Run deadline automation now?\\n\\nExpired OPEN/WAITING campaigns will be closed or cancelled.\u0027)) return;\n        fetch(\u0027/campaigns/deadline-automation/run\u0027, {\n            method: \u0027POST\u0027,\n            headers: { \u0027X-Admin\u0027: \u0027true\u0027 }\n        }).then(r \u003d\u0026gt; r.text()).then(msg \u003d\u0026gt; {\n            alert(\u0027✅ \u0027 + msg);\n            location.reload();\n        });\n    }\n\n    function saveAdminEdit(id) {\n        const title \u003d document.getElementById(\u0027admin-title\u0027).value.trim();\n        const deadline \u003d document.getElementById(\u0027admin-deadline\u0027).value;\n        const targetVal \u003d document.getElementById(\u0027admin-target\u0027).value;\n        const body \u003d {};\n        if (title) body.title \u003d title;\n        if (deadline) body.deadline \u003d deadline;\n        if (targetVal) body.targetAmount \u003d parseFloat(targetVal);\n        if (Object.keys(body).length \u003d\u003d\u003d 0) { alert(\u0027No changes to save.\u0027); return; }\n        fetch(\u0027/campaigns/\u0027 + id + \u0027/admin-edit\u0027, {\n            method: \u0027POST\u0027,\n            headers: { \u0027X-Admin\u0027: \u0027true\u0027, \u0027Content-Type\u0027: \u0027application/json\u0027 },\n            body: JSON.stringify(body)\n        }).then(r \u003d\u0026gt; r.ok ? location.reload() : r.text().then(t \u003d\u0026gt; alert(\u0027Error: \u0027 + t)));\n    }\n\u003c/script\u003e\n  \u003c/body\u003e\n\u003c/html\u003e","statusCode":200},"precondition":false,"level":0}],"userStory":{"id":"id.ac.ui.cs.advprog.donatjs.CampaignFunctionalTest","storyName":"CampaignFunctionalTest","displayName":"CampaignFunctionalTest","storyClassName":"id.ac.ui.cs.advprog.donatjs.CampaignFunctionalTest","path":"id.ac.ui.cs.advprog.donatjs.CampaignFunctionalTest","pathElements":[{"name":"id","description":"id"},{"name":"ac","description":"ac"},{"name":"ui","description":"ui"},{"name":"cs","description":"cs"},{"name":"advprog","description":"advprog"},{"name":"donatjs","description":"donatjs"},{"name":"CampaignFunctionalTest","description":"CampaignFunctionalTest"}],"narrative":"","type":"feature"},"title":"Campaign detail page renders for an existing campaign","tags":[{"name":"id/ac/ui/cs/advprog/donatjs/CampaignFunctionalTest","type":"feature","displayName":"CampaignFunctionalTest"}],"startTime":"2026-05-21T19:03:03.764206200+07:00[Asia/Jakarta]","endTime":"2026-05-21T19:03:05.419919100+07:00[Asia/Jakarta]","duration":1638,"projectKey":"","driver":"","isManualTestingUpToDate":false,"manual":false,"testSource":"JUnit5","order":0,"result":"SUCCESS"}