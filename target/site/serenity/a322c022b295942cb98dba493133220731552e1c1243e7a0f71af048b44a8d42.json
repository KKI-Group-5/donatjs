gn!\u003c/p\u003e\n        \u003cbr clear\u003d\"none\"/\u003e\n        \u003ca shape\u003d\"rect\" class\u003d\"btn-primary\" href\u003d\"/campaigns/create\" style\u003d\"margin-top:12px;\"\u003eCreate a Campaign\u003c/a\u003e\n      \u003c/div\u003e\n    \u003c/div\u003e\n    \u003cdiv class\u003d\"footer\"\u003e\n    © 2025 DonatJS — Advanced Programming Course Project\n\u003c/div\u003e\n    \u003cscript\u003e\n    // Animate progress bars\n    document.querySelectorAll(\u0027.progress-fill\u0027).forEach(el \u003d\u0026gt; {\n        const raised \u003d parseFloat(el.dataset.raised) || 0;\n        const target \u003d parseFloat(el.dataset.target) || 0;\n        if (target \u0026gt; 0) {\n            const pct \u003d Math.min(100, (raised / target) * 100).toFixed(1);\n            setTimeout(() \u003d\u0026gt; el.style.width \u003d pct + \u0027%\u0027, 100);\n        }\n    });\n\n    function runDeadlineAutomation() {\n        if (!confirm(\u0027Run deadline automation now?\\n\\nThis will close successful campaigns and cancel failed ones.\u0027)) return;\n        fetch(\u0027/campaigns/deadline-automation/run\u0027, {\n            method: \u0027POST\u0027,\n            headers: { \u0027X-Admin\u0027: \u0027true\u0027 }\n        }).then(r \u003d\u0026gt; r.text()).then(msg \u003d\u0026gt; {\n            alert(\u0027✅ \u0027 + msg);\n            location.reload();\n        }).catch(() \u003d\u0026gt; alert(\u0027Error running automation.\u0027));\n    }\n\u003c/script\u003e\n  \u003c/body\u003e\n\u003c/html\u003e","statusCode":200},"precondition":false,"level":0}],"userStory":{"id":"id.ac.ui.cs.advprog.donatjs.CampaignFunctionalTest","storyName":"CampaignFunctionalTest","displayName":"CampaignFunctionalTest","storyClassName":"id.ac.ui.cs.advprog.donatjs.CampaignFunctionalTest","path":"id.ac.ui.cs.advprog.donatjs.CampaignFunctionalTest","pathElements":[{"name":"id","description":"id"},{"name":"ac","description":"ac"},{"name":"ui","description":"ui"},{"name":"cs","de