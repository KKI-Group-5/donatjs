; flex-direction: column; gap: 10px; }\n        .card-title { font-size: 1.05rem; font-weight: 700; color: #1b5e20; line-height: 1.3; }\n        .card-desc { font-size: 0.85rem; color: #666; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; line-clamp: 2; -webkit-box-orient: vertical; }\n\n        .progress-section { margin-top: 4px; }\n        .progress-label { display: flex; justify-content: space-between; font-size: 0.8rem; color: #555; margin-bottom: 5px; }\n        .progress-wrap { background: #e8f5e9; border-radius: 20px; height: 8px; overflow: hidden; }\n        .progress-fill { background: linear-gradient(90deg, #2e7d32, #66bb6a); height: 100%; border-radius: 20px; width: 0%; transition: width 0.6s ease; }\n\n        .card-meta { display: flex; gap: 10px; flex-wrap: wrap; font-size: 0.8rem; color: #666; margin-top: 4px; }\n        .card-meta span { background: #f5f5f5; padding: 3px 8px; border-radius: 10px; }\n\n        .badge { display: inline-block; padding: 2px 10px; border-radius: 12px; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; }\n        .badge-WAITING { background: #fff8e1; color: #f57f17; border: 1px solid #ffe082; }\n        .badge-OPEN { background: #e8f5e9; color: #2e7d32; border: 1px solid #a5d6a7; }\n        .badge-CLOSED { background: #e3f2fd; color: #1565c0; border: 1px solid #90caf9; }\n        .badge-CANCELLED { background: #fce4ec; color: #c62828; border: 1px solid #f48fb1; }\n        .badge-REJECTED { background: #ede7f6; color: #4527a0; border: 1px solid #ce93d8; }\n        .badge-FRAUD { background: #ffebee; color: #b71c1c; border: 1px solid #ef9a9a; }\n        .badge-DELETED { background: #f5f5f5; color: #616161; border: 1px solid #bdbdbd; }\n\n        .card-footer { padding: 14px 20px; border-top: 1px solid #f0f0f0; display: flex; align-items: center; justify-content: space-between; }\n        .btn-view { background: #2e7d32; color: white; padding: 7px 18px; border-radius: 6px; 